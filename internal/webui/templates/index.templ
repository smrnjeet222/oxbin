package templates

templ Index() {
	@Layout("OxBin - File Viewer") {
		<div class="min-h-screen flex flex-col">
			<!-- Main Content -->
			<div class="flex-1 container mx-auto px-4 py-8">
				<!-- Hero Section -->
				<div class="hero min-h-[60vh]">
					<div class="hero-content text-center">
						<div class="max-w-lg">
							<!-- Logo -->
							<div class="mb-6">
								<img src="/assets/logo.png" alt="OxBin Logo" class="mx-auto max-w-sm h-auto" />
							</div>
							<p class="text-xl mb-8 text-base-content/80">
								Enter a blob ID to view or download files stored on Walrus
							</p>

							<!-- Blob ID Form -->
							<form method="POST" class="space-y-6">
								<div class="form-control w-full">
									<label class="label">
										<span class="label-text font-semibold text-lg">Blob ID</span>
									</label>
									@Input("text", "input-lg", templ.Attributes{
										"name": "blob_id",
										"placeholder": "Enter blob ID...",
										"required": true,
									})
								</div>
								<div class="form-control">
									@Button("primary", "btn-lg w-full h-14", templ.Attributes{
										"type": "submit",
									}) {
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
										</svg>
										<span class="text-lg font-semibold">View File</span>
									}
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>

			<!-- Footer - Sticky to bottom -->
			<footer class="footer footer-center p-6 bg-base-300 text-base-content mt-auto">
				<div>
					<p class="font-semibold text-lg">Powered by <a href="https://www.walrus.xyz/" target="_blank" class="text-primary">Walrus</a></p>
					<p class="text-base-content/70">Decentralized file storage made simple</p>
				</div>
			</footer>
		</div>
	}
}

package templates

import "github.com/smrnjeet222/oxbin/internal/core"
import "github.com/smrnjeet222/oxbin/internal/utils"

type BlobData struct {
	BlobID      string
	Content     string
	RawContent  []byte
	Metadata    *core.FileMetadata
	IsOxBinFile bool
	IsBinary    bool
	IsMedia     bool
	Language    string
	Error       string
	ContentType string
	Size        int64
}

templ Blob(data BlobData) {
	@Layout("OxBin - Blob Viewer") {
		<div class="container mx-auto px-4 py-4 min-h-screen flex flex-col">
			<!-- Navigation -->
			<div class="breadcrumbs text-sm mb-4">
				<ul>
					<li><a href="/" class="link link-primary">Home</a></li>
					<li>Blob Viewer</li>
				</ul>
			</div>

			if data.Error != "" {
				<!-- Error State -->
				<div class="flex flex-col items-center justify-center min-h-[60vh] space-y-6">
					@Alert("error", "max-w-2xl") {
						<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<div>
							<h3 class="font-bold">Failed to load blob</h3>
							<div class="text-xs">{ data.Error }</div>
						</div>
					}

					@Button("primary", "btn-lg", templ.Attributes{
						"onclick": "window.location.href='/'",
					}) {
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						Try Another Blob
					}
				</div>
			} else {
				<!-- Success State -->
				<div class="flex flex-col flex-1 space-y-4">
					<!-- Compact File Information Bar -->
					<div class="bg-base-100 rounded-lg p-4 shadow-sm">
						<div class="flex flex-wrap items-center justify-between gap-4">
							<!-- Left side: File info -->
							<div class="flex flex-wrap items-center gap-4 min-w-0 flex-1">
								<!-- Filename and size -->
								if data.IsOxBinFile && data.Metadata != nil {
									<div class="flex items-center gap-2 min-w-0">
										<span class="text-sm font-medium truncate">{ data.Metadata.Filename }</span>
										<span class="text-xs text-base-content/60">({ utils.FormatFileSize(data.Metadata.Size) })</span>
									</div>
								} else {
									<div class="flex items-center gap-2">
										<span class="text-sm text-base-content/60">{ utils.FormatFileSize(data.Size) }</span>
									</div>
								}

								<!-- Content type -->
								if data.ContentType != "" {
									<span class="text-xs px-2 py-1 bg-base-200 rounded">{ data.ContentType }</span>
								}

								<!-- File type badge -->
								if data.IsOxBinFile {
									<span class="text-xs px-2 py-1 bg-base-200 rounded">🦋 OxBin Format</span>
								} else {
									<span class="text-xs px-2 py-1 bg-base-200 rounded">📦 Raw File</span>
								}
							</div>

							<!-- Right side: OxBin badge and Actions -->
							<div class="flex items-center gap-3">

								<!-- Download button -->
								@Button("primary", "btn-sm", templ.Attributes{
									"onclick": "window.open('/download/" + data.BlobID + "', '_blank')",
								}) {
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
									</svg>
									Download
								}
							</div>
						</div>

						<!-- Blob ID (collapsible/hidden by default) -->
						<div class="mt-2 pt-2 border-t border-base-300">
							<div class="flex items-center gap-2">
								<span class="text-xs text-base-content/60">ID:</span>
								<code class="text-xs font-mono text-base-content/80 truncate flex-1">{ data.BlobID }</code>
							</div>
						</div>
					</div>

					<!-- Content Preview - Full Focus -->
					<div class="flex-1">
						if data.IsBinary && !data.IsMedia {
							<div class="mb-3">
								@Alert("warning", "alert-sm") {
									<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4" fill="none" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
									</svg>
									<span class="text-sm">Binary file - showing hex preview</span>
								}
							</div>
						}

						<!-- Content Display -->
						<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
							if data.IsMedia {
								@MediaDisplay(data.ContentType, data.BlobID, "min-h-[60vh]")
							} else {
								<div>
									<pre class="text-sm leading-relaxed text-gray-800 whitespace-pre-wrap overflow-auto max-h-[80vh]"><code class={ "language-" + data.Language }>{ data.Content }</code></pre>
								</div>
							}
						</div>
					</div>
				</div>
			}
		</div>

		<!-- JavaScript for syntax highlighting -->
		<script>
			// Initialize syntax highlighting when page loads
			document.addEventListener('DOMContentLoaded', function() {
				if (typeof Prism !== 'undefined') {
					Prism.highlightAll();
				}
			});
		</script>
	}
}

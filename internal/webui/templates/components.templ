package templates

import "strings"

// Button component with DaisyUI styling
templ Button(variant string, class string, attrs templ.Attributes) {
	if variant == "primary" || variant == "" {
		<button 
			class={ "cute-button inline-flex items-center justify-center rounded-xl bg-ink px-5 py-3 font-extrabold text-white shadow-[0_14px_30px_rgba(34,50,72,0.16)] disabled:cursor-not-allowed disabled:opacity-60", class }
			{ attrs... }
		>
			{ children... }
		</button>
	} else if variant == "secondary" {
		<button 
			class={ "cute-button inline-flex items-center justify-center rounded-xl bg-lagoon px-5 py-3 font-extrabold text-white shadow-[0_14px_30px_rgba(69,102,214,0.14)] disabled:cursor-not-allowed disabled:opacity-60", class }
			{ attrs... }
		>
			{ children... }
		</button>
	} else if variant == "outline" {
		<button 
			class={ "cute-button inline-flex items-center justify-center rounded-xl border border-white/80 bg-white/70 px-5 py-3 font-extrabold text-ink shadow-sm backdrop-blur disabled:cursor-not-allowed disabled:opacity-60", class }
			{ attrs... }
		>
			{ children... }
		</button>
	} else if variant == "ghost" {
		<button 
			class={ "inline-flex items-center justify-center rounded-xl px-5 py-3 font-extrabold text-ink/70 transition hover:bg-white/70 hover:text-ink disabled:cursor-not-allowed disabled:opacity-60", class }
			{ attrs... }
		>
			{ children... }
		</button>
	} else if variant == "neutral" {
		<button 
			class={ "cute-button inline-flex items-center justify-center rounded-xl bg-ink/80 px-5 py-3 font-extrabold text-white shadow-sm disabled:cursor-not-allowed disabled:opacity-60", class }
			{ attrs... }
		>
			{ children... }
		</button>
	}
}

// Input component
templ Input(inputType string, class string, attrs templ.Attributes) {
	<input 
		type={ inputType }
		class={ "w-full rounded-xl border border-sui/40 bg-white/80 px-5 py-4 text-ink outline-none transition placeholder:text-ink/35 focus:border-lagoon focus:ring-4 focus:ring-sui/30", class }
		{ attrs... }
	/>
}

// Card component
templ Card(class string) {
	<div class={ "glass-card rounded-2xl", class }>
		{ children... }
	</div>
}

templ CardHeader(class string) {
	<div class={ "p-6 sm:p-8", class }>
		{ children... }
	</div>
}

templ CardTitle(class string) {
	<h2 class={ "font-display text-2xl font-bold text-ink", class }>
		{ children... }
	</h2>
}

templ CardDescription(class string) {
	<p class={ "text-ink/68", class }>
		{ children... }
	</p>
}

templ CardContent(class string) {
	<div class={ "px-6 pb-6 sm:px-8 sm:pb-8", class }>
		{ children... }
	</div>
}

// Badge component
templ Badge(variant string, class string) {
	if variant == "primary" || variant == "" {
		<div class={ "inline-flex items-center rounded-lg bg-lagoon px-3 py-1 text-xs font-extrabold text-white", class }>
			{ children... }
		</div>
	} else if variant == "secondary" {
		<div class={ "inline-flex items-center rounded-lg bg-coral/20 px-3 py-1 text-xs font-extrabold text-ink", class }>
			{ children... }
		</div>
	} else if variant == "outline" {
		<div class={ "inline-flex items-center rounded-lg border border-sui/50 bg-white/60 px-3 py-1 text-xs font-extrabold text-ink", class }>
			{ children... }
		</div>
	} else if variant == "success" {
		<div class={ "inline-flex items-center rounded-lg bg-reef/25 px-3 py-1 text-xs font-extrabold text-ink", class }>
			{ children... }
		</div>
	} else if variant == "error" {
		<div class={ "inline-flex items-center rounded-lg bg-coral/25 px-3 py-1 text-xs font-extrabold text-ink", class }>
			{ children... }
		</div>
	} else if variant == "warning" {
		<div class={ "inline-flex items-center rounded-lg bg-amber-200/70 px-3 py-1 text-xs font-extrabold text-ink", class }>
			{ children... }
		</div>
	} else if variant == "info" {
		<div class={ "inline-flex items-center rounded-lg bg-sui/35 px-3 py-1 text-xs font-extrabold text-ink", class }>
			{ children... }
		</div>
	}
}

// Alert component
templ Alert(variant string, class string) {
	if variant == "info" || variant == "" {
		<div class={ "rounded-xl border border-sui/40 bg-sui/15 p-4 text-ink", class }>
			{ children... }
		</div>
	} else if variant == "success" {
		<div class={ "rounded-xl border border-reef/40 bg-reef/15 p-4 text-ink", class }>
			{ children... }
		</div>
	} else if variant == "warning" {
		<div class={ "rounded-xl border border-amber-300/60 bg-amber-100/60 p-4 text-ink", class }>
			{ children... }
		</div>
	} else if variant == "error" {
		<div class={ "rounded-xl border border-coral/50 bg-coral/15 p-4 text-ink", class }>
			{ children... }
		</div>
	}
}

// Code block component with syntax highlighting
templ CodeBlock(language string, class string) {
	<div class={ "overflow-hidden rounded-xl border border-sui/30 bg-slate-950 text-slate-100 shadow-inner", class }>
		if language != "" {
			<pre class="max-h-[72vh] overflow-auto p-5 text-sm leading-7"><code class={ "language-" + language }>{ children... }</code></pre>
		} else {
			<pre class="max-h-[72vh] overflow-auto p-5 text-sm leading-7"><code>{ children... }</code></pre>
		}
	</div>
}

// Media display component for images, videos, etc.
templ MediaDisplay(contentType string, blobID string, class string) {
	<div class={ "flex items-center justify-center rounded-xl bg-white/60 p-4", class }>
		if strings.HasPrefix(contentType, "image/") {
			if contentType == "image/svg+xml" {
				<div class="w-full">
					<iframe 
						src={ "/api/blob/" + blobID }
						class="h-full min-h-[60vh] w-full rounded-xl border border-sui/30 bg-white"
						title="SVG Content"
					></iframe>
				</div>
			} else {
				<img 
					src={ "/api/blob/" + blobID }
					alt="Image content"
					class="max-h-full max-w-full rounded-xl object-contain shadow-[0_16px_40px_rgba(34,50,72,0.12)]"
					style="max-height: 80vh;"
					loading="lazy"
				/>
			}
		} else if strings.HasPrefix(contentType, "video/") {
			<video 
				controls
				class="h-auto max-h-[76vh] w-full rounded-xl object-contain shadow-[0_16px_40px_rgba(34,50,72,0.12)]"
			>
				<source src={ "/api/blob/" + blobID } type={ contentType }/>
				Your browser does not support the video tag.
			</video>
		} else if strings.HasPrefix(contentType, "audio/") {
			<div class="w-full max-w-2xl rounded-xl border border-sui/30 bg-white/80 p-6">
				<audio 
					controls
					class="w-full"
				>
					<source src={ "/api/blob/" + blobID } type={ contentType }/>
					Your browser does not support the audio tag.
				</audio>
			</div>
		} else if contentType == "application/pdf" {
			<div class="w-full h-full">
				<iframe 
					src={ "/api/blob/" + blobID }
					class="h-full min-h-[70vh] w-full rounded-xl border border-sui/30 bg-white"
					title="PDF Content"
				></iframe>
			</div>
		} else {
			<div class="flex items-start gap-3 rounded-xl border border-sui/40 bg-sui/15 p-4 text-ink">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 text-lagoon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
				<div>
					<h3 class="font-display text-lg font-bold">Media file detected</h3>
					<div class="text-sm text-ink/64">{ contentType } - use download to open it with a local app.</div>
				</div>
			</div>
		}
	</div>
}

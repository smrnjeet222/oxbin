package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href="/assets/icon.png"/>
			<link rel="apple-touch-icon" href="/assets/icon.png"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script>
				tailwind.config = {
					theme: {
						extend: {
							fontFamily: {
								display: ['Fraunces', 'serif'],
								body: ['Nunito Sans', 'sans-serif'],
							},
							colors: {
								ink: '#223248',
								reef: '#6ce0d2',
								sui: '#8fd7ff',
								shell: '#fff7ed',
								coral: '#ff9cbd',
								kelp: '#6d8f71',
								lagoon: '#4566d6',
							}
						}
					}
				}
			</script>
			<!-- Prism.js for syntax highlighting -->
			<link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism.min.css" rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-core.min.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
			<style>
				:root {
					color: #223248;
					background: #fff7ed;
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: "Nunito Sans", sans-serif;
					background: 
						radial-gradient(circle at 0% 0%, rgba(143, 215, 255, 0.16) 0%, transparent 45%),
						radial-gradient(circle at 100% 0%, rgba(108, 224, 210, 0.12) 0%, transparent 40%),
						radial-gradient(circle at 100% 100%, rgba(255, 156, 189, 0.14) 0%, transparent 45%),
						radial-gradient(circle at 0% 100%, rgba(255, 247, 237, 0.4) 0%, transparent 50%),
						linear-gradient(135deg, #fafcff 0%, #fffdfb 50%, #fffafc 100%);
					color: #223248;
				}

				pre {
					margin: 0 !important;
				}

				.ox-shell {
					position: relative;
					isolation: isolate;
					overflow-x: hidden;
				}

				.ox-shell::before,
				.ox-shell::after {
					content: "";
					position: fixed;
					inset: auto;
					z-index: -1;
					border-radius: 999px;
					filter: blur(6px);
					opacity: 0.74;
					pointer-events: none;
				}

				.ox-shell::before {
					width: 22rem;
					height: 22rem;
					left: -8rem;
					bottom: 8rem;
					background: radial-gradient(circle, rgba(108, 224, 210, 0.14), transparent 70%);
				}

				.ox-shell::after {
					width: 28rem;
					height: 28rem;
					right: -10rem;
					top: 16rem;
					background: radial-gradient(circle, rgba(255, 214, 228, 0.22), transparent 68%);
				}

				.glass-card {
					border: 1px solid rgba(199, 225, 238, 0.72);
					background: rgba(255, 255, 255, 0.74);
					box-shadow: 0 16px 44px rgba(34, 50, 72, 0.08);
					backdrop-filter: blur(18px);
				}

				.soft-card {
					border: 1px solid rgba(199, 225, 238, 0.76);
					background: rgba(255, 255, 255, 0.82);
					box-shadow: 0 12px 32px rgba(34, 50, 72, 0.06);
				}

				.walrus-grid {
					background-image:
						linear-gradient(rgba(69, 102, 214, 0.08) 1px, transparent 1px),
						linear-gradient(90deg, rgba(69, 102, 214, 0.08) 1px, transparent 1px);
					background-size: 34px 34px;
					mask-image: radial-gradient(circle at center, black, transparent 78%);
				}

				.cute-button {
					transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
				}

				.cute-button:hover {
					transform: translateY(-2px);
				}

				.dropzone-active {
					border-color: #4566d6 !important;
					background: rgba(143, 215, 255, 0.28) !important;
					box-shadow: 0 14px 38px rgba(69, 102, 214, 0.12);
				}

				.reveal-up {
					animation: reveal-up 600ms ease both;
				}

				@keyframes reveal-up {
					from {
						opacity: 0;
						transform: translateY(16px);
					}
					to {
						opacity: 1;
						transform: translateY(0);
					}
				}
			</style>
		</head>
		<body data-theme="cupcake" class="min-h-screen font-body antialiased">
			<div class="ox-shell min-h-screen">
				{ children... }
			</div>
		</body>
	</html>
}
